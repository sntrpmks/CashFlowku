<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBg">

    <!-- Top AppBar -->
    <RelativeLayout
        android:id="@+id/layout_header_sales"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/colorPrimary"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/btn_back_sales"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="←"
            android:textColor="@color/colorOnPrimary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/btn_back_sales"
            android:layout_marginStart="16dp"
            android:text="Daftar Penjualan"
            android:textColor="@color/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Filters Section -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_filters_sales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/layout_header_sales">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Search input -->
            <EditText
                android:id="@+id/et_search_sales"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_pill"
                android:hint="Cari produk yang terjual..."
                android:textColorHint="@color/textMuted"
                android:textColor="@color/textPrimary"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textSize="14sp" />

            <!-- Date pickers row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_sales_from_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Dari Tanggal"
                    android:textColorHint="@color/textMuted"
                    android:textColor="@color/textPrimary"
                    android:inputType="none"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_sales_to_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Hingga Tanggal"
                    android:textColorHint="@color/textMuted"
                    android:textColor="@color/textPrimary"
                    android:inputType="none"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_filter_sales_reset"
                    style="@style/Widget.CashFlowku.Button.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:text="Reset"
                    android:textSize="12sp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Summary Banner -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_summary_sales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/colorCardBg"
        app:layout_constraintTop_toBottomOf="@id/card_filters_sales">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/colorIncome" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total Pendapatan Terfilter"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_total_sales_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="@color/colorIncome"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Recycler View List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sales_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/card_summary_sales"
        tools:listitem="@layout/item_transaction" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_sales"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:gravity="center"
        android:text="Belum ada transaksi penjualan."
        android:textColor="@color/textSecondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/card_summary_sales" />

    <!-- FAB to Add Sale -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_sale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:contentDescription="Tambah Penjualan"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="@color/colorAccent"
        app:tint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
